<Window x:Class="SimpleLoginApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="300" Width="400">
	<Grid>
		<!-- Background Color -->
		<Grid.Background>
			<SolidColorBrush Color="#f4f4f4"/>
		</Grid.Background>

		<!-- Login Form Container -->
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
			<!-- Username Field -->
			<TextBox Name="Username" Width="250" Height="40" Margin="0,0,0,20"
                     PlaceholderText="Username" FontSize="14" Padding="10,0,0,0"/>

			<!-- Password Field -->
			<PasswordBox Name="Password" Width="250" Height="40" Margin="0,0,0,20"
                         PlaceholderText="Password" FontSize="14" Padding="10,0,0,0"/>

			<!-- Login Button -->
			<Button Content="Login" Width="250" Height="40" Margin="0,0,0,20"
                    Background="#0078D4" Foreground="White" FontSize="16" Click="LoginButton_Click"/>

			<!-- Error Message Text (Hidden by default) -->
			<TextBlock Name="ErrorMessage" Foreground="Red" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed"/>
		</StackPanel>
	</Grid>
</Window>

